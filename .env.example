# Postgres (Neon). Pooled URL used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) URL used by Prisma migrations.
DIRECT_URL=

# Firebase web config (public, used by the browser SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side ID token verification: tokens must be issued for this project.
FIREBASE_PROJECT_ID=
